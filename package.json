{
  "name": "nuwa-agent-relay-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "smoke:setup": "node scripts/smoke/setup.mjs",
    "smoke:a": "node scripts/smoke/side-a.mjs",
    "smoke:b": "node scripts/smoke/side-b.mjs",
    "smoke:cleanup": "node scripts/smoke/cleanup.mjs",
    "test:smoke": "node --test scripts/smoke/Checks.mjs scripts/smoke/ResumeCheck.mjs scripts/smoke/WakeAuthChecks.mjs",
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run test/CoreFlow.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "wrangler deploy",
    "audit:report": "node scripts/audit-report.mjs",
    "audit:check": "node scripts/audit-report.mjs --enforce",
    "smoke:login": "node scripts/smoke/login.mjs",
    "smoke:logout": "node scripts/smoke/logout.mjs",
    "smoke:receipts": "node scripts/smoke/receipts.mjs",
    "smoke:wake:register": "node scripts/smoke/wake-register.mjs",
    "smoke:wake:listen": "node scripts/smoke/wake-listen.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.38.0",
    "@cloudflare/vitest-plugin": "^1.4.7"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}

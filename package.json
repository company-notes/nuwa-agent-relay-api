{
  "name": "nuwa-agent-relay-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:smoke": "node --test scripts/V2Smoke.checks.mjs scripts/GuardV2D1.checks.mjs",
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run test/CoreFlow.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "node scripts/GuardV2D1.mjs --remote && wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/GuardV2D1.mjs --remote --require-migrated && wrangler deploy",
    "audit:report": "node scripts/audit-report.mjs",
    "audit:check": "node scripts/audit-report.mjs --enforce",
    "smoke:v2": "node scripts/V2Smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.38.0",
    "@cloudflare/vitest-plugin": "^1.4.7"
  },
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
